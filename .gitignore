# Gradle and IDE output
.gradle/
**/build/
**/out/
.idea/
*.iml
.vscode/

# Compiled binaries and object files
*.exe
*.dll
*.lib
*.obj
*.pdb
*.bin
*.class
*.cfr
*.jar
**/*.jar
*.zip
**/*.zip



# Local runtime/test data
run/
crash-reports/

# Reference binaries and native artifacts are intentionally not versioned
reference/
builds/
buildsdemiamigo/
# Third party and components with proprietary or community binaries
logs/research/dlssg-ampere/deep/components/
logs/runtime/dlssg-external-harness/**/component/
logs/runtime/dlssg-external-harness/**/stock-runtime/
logs/runtime/dlssg-external-harness/**/bundle-cache/
# Local fixture previews; publish only textual evidence and hashes for new runs.
logs/runtime/dlssg-external-harness/**/*.png
logs/runtime/dlssg-external-harness/**/*.ppm
experiments/ngx-dlssg-probe/vendor/*.dll
experiments/ngx-dlssg-probe/vendor/*.lib
logs/runtime/dlssg-vk-d3d12-x2/**/component/
logs/runtime/dlssg-vk-d3d12-x2/**/stock-runtime/
logs/runtime/dlssg-vk-d3d12-x2/**/bundle-cache/
logs/runtime/dlssg-vk-d3d12-x2/**/*.png
logs/runtime/dlssg-vk-d3d12-x2/**/*.ppm

# Isolated baseline runtime generated data (keep launcher configuration)
runtime-baseline/instance/

# Python caches and transient evidence checkpoints (derived review is versioned)
__pycache__/
*.pyc
*.tmp
worker-recovery.json

# Nested upstream rules unignore JARs; prune the local wrapper binary directory.
# Already tracked wrapper scripts/properties remain tracked.
superresolution/gradle/wrapper/
