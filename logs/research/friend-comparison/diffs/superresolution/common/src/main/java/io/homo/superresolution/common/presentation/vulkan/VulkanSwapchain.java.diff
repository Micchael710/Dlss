+                transitionCount++;
+                if (layoutAtAcquire != VK_IMAGE_LAYOUT_UNDEFINED) {
+                    sourceStageMask = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+                }
+            }
